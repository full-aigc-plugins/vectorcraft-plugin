{
  "schema": "craft-scenario-playbooks/v1",
  "application": "vectorcraft",
  "id": "sticker-grid",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "command": "file.new",
      "params": {
        "width": 320,
        "height": 240,
        "units": "Pixels",
        "backgroundContents": "white"
      },
      "batch": "new",
      "purpose": "仅在新作品任务建立独立画板"
    },
    {
      "command": "shape.ellipse",
      "params": {
        "x": 20,
        "y": 20,
        "width": 30,
        "height": 30
      },
      "batch": "art",
      "capture": "art",
      "purpose": "创建本次圆形并记录真实返回id"
    },
    {
      "command": "paint.setFill",
      "params": {
        "color": "#2563eb"
      },
      "batch": "art",
      "purpose": "设置目标填色；无ids时仅作用于当前批次新对象"
    },
    {
      "command": "paint.setStroke",
      "params": {
        "none": true
      },
      "batch": "art",
      "purpose": "显式去掉描边以避免继承默认黑边"
    },
    {
      "command": "object.repeat.grid",
      "params": {
        "ids": [
          {
            "$ref": "art.id"
          }
        ],
        "rows": 3,
        "cols": 4,
        "hSpacing": 20,
        "vSpacing": 20
      },
      "batch": "grid",
      "capture": "repeat",
      "purpose": "以源对象真实ID建立可编辑行列阵列"
    }
  ],
  "check": "保存为可编辑Grid Repeat，原稿仅有一个源图；重开可改行列、改源图颜色并同步实例，另存展开副本得到12个真实独立图形。",
  "boundary": "确认单个贴纸尺寸、行列数、水平/垂直净间距和画板范围。例子是30×30pt源图、20pt净间距、3行4列，不是自动填满纸张或印刷拼版。",
  "templateOnly": true,
  "argumentPolicy": "batch/capture/$ref是手册记号，不能直接传给原生CLI。每批读取实际返回值后解析下一批参数；已有文档不能套用示例对象ID。"
}
