{
  "schema": "craft-scenario-playbooks/v1",
  "application": "vectorcraft",
  "id": "logo-system",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "用几何构造标志外轮廓",
      "command": "shape.rectangle",
      "params": {
        "x": 20,
        "y": 20,
        "width": 120,
        "height": 80,
        "radius": 12
      }
    },
    {
      "purpose": "填入品牌主色",
      "command": "paint.setFill",
      "params": {
        "color": "#2457cc"
      }
    },
    {
      "purpose": "复制反射变体，确认使用意图",
      "command": "object.reflect",
      "params": {
        "axis": "vertical",
        "copy": true
      }
    },
    {
      "purpose": "编组并保留路径可编辑",
      "command": "object.group",
      "params": {}
    }
  ],
  "check": "检查负空间、小尺寸辨识度、单色与反白版，并保留文字字体信息。",
  "boundary": "组合前选择实际对象；反射仅适合已确认的几何标志，不镜像品牌文字。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
