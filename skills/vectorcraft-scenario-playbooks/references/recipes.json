    {
      "id": "approval-check-badge",
      "title": "可编辑审核通过徽章",
      "category": "vector-design",
      "inputs": "240×240屏幕画板，绿色圆底和白色勾号；不是认证标识。",
      "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
      "steps": [
        {
          "purpose": "仅新建独立场景时建立画板",
          "command": "file.new",
          "params": {
            "name": "可编辑审核通过徽章",
            "width": 240,
            "height": 240,
            "units": "Pixels",
            "backgroundContents": "white"
          },
          "parameterReference": "command-evidence.json#file.new",
          "newDocumentOnly": true
        },
        {
          "purpose": "创建底圆",
          "command": "shape.ellipse",
          "params": {
            "x": 20,
            "y": 20,
            "width": 200,
            "height": 200
          },
          "parameterReference": "command-evidence.json#shape.ellipse"
        },
        {
          "purpose": "设置当前新建对象填色",
          "command": "paint.setFill",
          "params": {
            "color": "#16804a"
          },
          "parameterReference": "command-evidence.json#paint.setFill"
        },
        {
          "purpose": "去除当前对象描边",
          "command": "paint.setStroke",
          "params": {
            "none": true
          },
          "parameterReference": "command-evidence.json#paint.setStroke"
        },
        {
          "purpose": "创建未闭合勾号路径",
          "command": "path.create",
          "params": {
            "d": "M 65 120 L 105 160 L 180 80"
          },
          "parameterReference": "command-evidence.json#path.create"
        },
        {
          "purpose": "开放路径不填充",
          "command": "paint.setFill",
          "params": {
            "none": true
          },
          "parameterReference": "command-evidence.json#paint.setFill"
        },
        {
          "purpose": "设置白色线条",
          "command": "paint.setStroke",
          "params": {
            "color": "#ffffff"
          },
          "parameterReference": "command-evidence.json#paint.setStroke"
        },
        {
          "purpose": "设置圆端点与圆连接",
          "command": "stroke.set",
          "params": {
            "weight": 16,
            "cap": "round",
            "join": "round"
          },
          "parameterReference": "command-evidence.json#stroke.set"
        }
      ],
      "assertions": {
        "kindCounts": {
          "Ellipse": 1,
          "Path": 1
        },
        "stroke": {
          "width": 16,
          "cap": "round"
        },
        "fills": [
          "#16804a"
        ],
        "artboard": [
          240,
          240
        ]
      },
      "checks": [
        "圆与勾号保留独立编辑",
        "勾号路径未闭合且白色描边宽16",
        "缩小后检查识别度"
      ],
      "limits": "示例仅图形制作，不意味着获得第三方批准或认证。"
    },
