    {
      "id": "hollow-ring-minus-front",
      "title": "验证真实几何而非白色遮盖",
      "sourceIds": [
        "github/awesome-copilot/adobe-illustrator-scripting"
      ],
      "adaptation": "明确外径和内径，按真实对象执行布尔减法；随后在有色背景检查透空部分，查看对象结构确认不是白圆覆盖。",
      "taskCheck": "中心透明且布尔结果可保存重开，不依赖白色背景。",
      "capabilityBoundary": "路径与颜色值使用Craft当前schema，不能照搬Illustrator坐标对象。",
      "existingRecipe": "skills/vectorcraft-scenario-playbooks/references/recipes.json",
      "recipe": {
        "id": "hollow-ring-minus-front",
        "title": "真实镂空圆环",
        "category": "vector-design",
        "inputs": "外圆160内圆80，先外后内；共同中心120,120。",
        "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
        "steps": [
          {
            "purpose": "仅新建独立场景时建立画板",
            "command": "file.new",
            "params": {
              "name": "真实镂空圆环",
              "width": 240,
              "height": 240,
              "units": "Pixels",
              "backgroundContents": "white"
            },
            "parameterReference": "command-evidence.json#file.new",
            "newDocumentOnly": true
          },
          {
            "purpose": "先创建后方外圆",
            "command": "shape.ellipse",
            "params": {
              "x": 40,
              "y": 40,
              "width": 160,
              "height": 160
            },
            "parameterReference": "command-evidence.json#shape.ellipse"
          },
          {
            "purpose": "设置当前新建对象填色",
            "command": "paint.setFill",
            "params": {
              "color": "#2563eb"
            },
            "parameterReference": "command-evidence.json#paint.setFill"
          },
          {
            "purpose": "去除当前对象描边",
            "command": "paint.setStroke",
            "params": {
              "none": true
            },
            "parameterReference": "command-evidence.json#paint.setStroke"
          },
          {
            "purpose": "再创建前方切除圆",
            "command": "shape.ellipse",
            "params": {
              "x": 80,
              "y": 80,
              "width": 80,
              "height": 80
            },
            "parameterReference": "command-evidence.json#shape.ellipse"
          },
          {
            "purpose": "设置当前新建对象填色",
            "command": "paint.setFill",
            "params": {
              "color": "#2563eb"
            },
            "parameterReference": "command-evidence.json#paint.setFill"
          },
          {
            "purpose": "去除当前对象描边",
            "command": "paint.setStroke",
            "params": {
              "none": true
            },
            "parameterReference": "command-evidence.json#paint.setStroke"
          },
          {
            "purpose": "只在本例独立新图选择本次全部对象",
            "command": "select.all",
            "params": {},
            "parameterReference": "command-evidence.json#select.all",
            "ownedSelectionOnly": true
          },
          {
            "purpose": "前圆从后圆相减，生成真实镂空",
            "command": "object.pathfinder.minusFront",
            "params": {},
            "parameterReference": "command-evidence.json#object.pathfinder.minusFront"
          },
          {
            "purpose": "设置当前新建对象填色",
            "command": "paint.setFill",
            "params": {
              "color": "#2563eb"
            },
            "parameterReference": "command-evidence.json#paint.setFill"
          },
          {
            "purpose": "去除当前对象描边",
            "command": "paint.setStroke",
            "params": {
              "none": true
            },
            "parameterReference": "command-evidence.json#paint.setStroke"
          }
        ],
        "assertions": {
          "compoundRequired": true,
          "ringPixels": true,
          "fills": [
            "#2563eb"
          ],
          "artboard": [
            240,
            240
          ]
        },
        "checks": [
          "中心透明/底色透出且环带存在",
          "不是白圆盖住蓝圆",
          "SVG保留复合路径"
        ],
        "limits": "已有图纸用实际两圆ID调用select.set，不可select.all；反向堆叠会产生不同结果。"
      },
      "execution": "REFERENCE_ADAPTATION_NOT_NEW_RUNTIME_ACCEPTANCE"
    }
