    {
      "id": "wordmark-live-and-outlined",
      "title": "文字母版与轮廓交付分开",
      "sourceIds": [
        "github/awesome-copilot/adobe-illustrator-scripting",
        "skillhub:adobe-illustrator-scripting"
      ],
      "adaptation": "先确认实际字体可用，再制作活文字母版；复制为另一个输出后，仅对本次标志转轮廓。交接时说明哪份可改字，哪份用于无字体环境。",
      "taskCheck": "母版文字仍可编辑，轮廓版外观一致且文件名不同。",
      "capabilityBoundary": "不运行Illustrator JSX；不把整份既有图的其他文字一起转轮廓。",
      "existingRecipe": "skills/vectorcraft-scenario-playbooks/references/recipes.json",
      "recipe": {
        "id": "wordmark-live-and-outlined",
        "title": "文字标志母版与轮廓交付",
        "category": "vector-design",
        "inputs": "示例文字CRAFT，Arial字体；先确认实际字体存在和使用授权。",
        "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
        "steps": [
          {
            "purpose": "仅新建独立场景时建立画板",
            "command": "file.new",
            "params": {
              "name": "文字标志母版与轮廓交付",
              "width": 420,
              "height": 160,
              "units": "Pixels",
              "backgroundContents": "white"
            },
            "parameterReference": "command-evidence.json#file.new",
            "newDocumentOnly": true
          },
          {
            "purpose": "创建可编辑文字",
            "command": "text.create",
            "params": {
              "x": 30,
              "y": 105,
              "text": "CRAFT",
              "size": 64,
              "font": "Arial",
              "color": "#172033"
            },
            "parameterReference": "command-evidence.json#text.create"
          },
          {
            "purpose": "转轮廓前保存可编辑文字母版",
            "command": "file.save",
            "params": {
              "path": "wordmark-live.vectorcraft"
            },
            "parameterReference": "command-evidence.json#file.save"
          },
          {
            "purpose": "保持当前文字选区并转成字形路径",
            "command": "type.createOutlines",
            "params": {},
            "parameterReference": "command-evidence.json#type.createOutlines"
          },
          {
            "purpose": "显式另存轮廓交付，避免普通保存覆盖活文字母版",
            "command": "file.save",
            "params": {
              "path": "wordmark-outlined.vectorcraft"
            },
            "parameterReference": "command-evidence.json#file.save"
          }
        ],
        "assertions": {
          "textCount": 0,
          "outlinedRequired": true,
          "liveMaster": "wordmark-live.vectorcraft",
          "masterText": "CRAFT",
          "artboard": [
            420,
            160
          ],
          "fixtureOnly": true,
          "outlinedFile": "wordmark-outlined.vectorcraft"
        },
        "checks": [
          "母版仍含CRAFT文字",
          "独立新图交付工程无活文字且含轮廓；既有图仅检查本次文字，其他文字保留可编辑",
          "母版与轮廓版文件名不同"
        ],
        "limits": "转轮廓不可当成仍可改字；不能仅保存最终轮廓而丢失母版。固定母版路径是新目录示例，真实任务用未占用路径。"
      },
      "execution": "REFERENCE_ADAPTATION_NOT_NEW_RUNTIME_ACCEPTANCE"
    },
