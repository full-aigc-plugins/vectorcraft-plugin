{
  "schema": "craft-scenario-playbooks/v1",
  "application": "vectorcraft",
  "id": "trace-artwork",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "读取当前可用描摹预设",
      "command": "imageTrace.presets",
      "params": {}
    },
    {
      "purpose": "对已选择位图执行描摹",
      "command": "imageTrace.make",
      "params": {
        "preset": "Black and White Logo"
      }
    },
    {
      "purpose": "核对描摹后转为路径",
      "command": "imageTrace.expand",
      "params": {}
    },
    {
      "purpose": "适度减少冗余节点",
      "command": "object.path.simplify",
      "params": {
        "tolerance": 0.5,
        "cornerAngle": 30
      }
    }
  ],
  "check": "细线、孔洞和轮廓对照原图，不以节点变少代替形状保真。",
  "boundary": "预设名必须由 imageTrace.presets 实际返回确认；失焦照片不适合精确图纸描摹。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
