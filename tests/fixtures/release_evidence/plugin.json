{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vectorcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "标志、图标集、信息图、SVG 清理与多画板变体；导出 SVG、PDF 与 PNG，路径保持可编辑。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/vectorcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/vectorcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "vectorcraft",
    "creative-workflow",
    "development-release"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "VectorCraft（矢量设计）",
        "shortDescription": "标志、图标、信息图与 SVG，导出可编辑矢量工程",
        "longDescription": "Use independently maintained, checksummed skills to install pinned native CLIs and create editable native projects. Development release; complete capability and host acceptance remain in progress.",
        "developerName": "Full AIGC Plugins",
        "category": "Creativity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/full-aigc-plugins/vectorcraft-plugin",
        "defaultPrompt": [
          "Create an editable VectorCraft project from my assets"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "VectorCraft"
    }
  }
}
