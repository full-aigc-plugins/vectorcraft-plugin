{
  "name": "vectorcraft",
  "version": "0.1.0-dev.20261109.4",
  "description": "标志、图标集、信息图与 SVG 清理，多画板变体，导出 SVG/PDF/PNG 且路径可编辑。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/vectorcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/vectorcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "vectorcraft",
    "creative-workflow",
    "development-release"
  ],
  "skills": "./skills/",
  "displayName": "VectorCraft",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "vectorcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "VectorCraft",
    "zh-CN": "VectorCraft"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "VectorCraft",
          "zh-CN": "VectorCraft"
        },
        "icon": "pen-tool",
        "server": "vectorcraft-editor",
        "resourceUri": "ui://vectorcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
